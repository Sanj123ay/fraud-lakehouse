# ============================================================================
#  LOCAL SETTINGS TEMPLATE
#  1) Copy this file:   cp .env.example .env
#  2) .env is listed in .gitignore, so your real passwords never reach GitHub.
#  Defaults below are fine for local learning — no need to change anything.
# ============================================================================

# ---- MinIO: local S3 where the Iceberg lakehouse lives ----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# ---- Postgres "ops" DB: Airflow metadata + fraud predictions ----
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
AIRFLOW_META_DB=airflow_meta
FRAUD_OPS_DB=fraud_ops

# ---- Postgres "source" DB: pretends to be the bank's core system (CDC source) ----
SOURCE_DB_USER=shop
SOURCE_DB_PASSWORD=shop
SOURCE_DB_NAME=shopdb

# ---- Airflow web UI login ----
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin

# ---- Settings the Spark jobs read (defaults already work inside Docker) ----
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_TOPIC_RAW=raw_transactions
S3_ENDPOINT_URL=http://minio:9000
ICEBERG_WAREHOUSE=s3a://warehouse/iceberg
CHECKPOINTS_ROOT=s3a://checkpoints
MODEL_PATH=s3a://models/fraud_rf/latest
