# ============================================================================
#  LOCAL SETTINGS TEMPLATE
#  1) Copy this file:   cp .env.example .env
#  2) .env is listed in .gitignore, so your real passwords never reach GitHub.
#  Defaults below are fine for local learning — no need to change anything.
# ============================================================================

# ---- MinIO: local S3 where the Iceberg lakehouse lives ----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# ---- Postgres "ops" DB: Airflow metadata + fraud predictions ----
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
AIRFLOW_META_DB=airflow_meta
FRAUD_OPS_DB=fraud_ops

# ---- Postgres "source" DB: pretends to be the bank's core system (CDC source) ----
SOURCE_DB_USER=shop
SOURCE_DB_PASSWORD=shop
SOURCE_DB_NAME=shopdb

# ---- Airflow web UI login ----
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin


# ---- NiFi transaction simulator ----
# 0.06 = 6% of generated transactions have planted fraud characteristics.
SIMULATED_FRAUD_RATE=0.06


# ---- Settings the Spark jobs read (defaults already work inside Docker) ----
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_TOPIC_RAW=raw_transactions
# "earliest" replays existing Kafka data only when a checkpoint is first created.
KAFKA_STARTING_OFFSETS=earliest
KAFKA_MAX_OFFSETS_PER_TRIGGER=5000
STREAM_TRIGGER=10 seconds
EVENT_WATERMARK=10 minutes
FEATURE_VERSION=v1
# Browser-visible Spark master URL used for proxy links to app/worker UIs.
SPARK_UI_REVERSE_PROXY_URL=http://localhost:8080
S3_ENDPOINT_URL=http://minio:9000
ICEBERG_WAREHOUSE=s3a://warehouse/iceberg
CHECKPOINTS_ROOT=s3a://checkpoints
MODEL_PATH=s3a://models/fraud_rf/latest

# ---- Step 5: model training rules (defaults are fine for learning) ----
# Skip training until there are at least this many labelled transactions...
TRAIN_MIN_ROWS=2000
# ...and at least this many fraud examples (otherwise the model learns nothing).
TRAIN_MIN_FRAUD_ROWS=50
# Newest 20% of transactions are the untouched test set.
TRAIN_HOLDOUT_FRACTION=0.2
# A new model must reach this AUC to be published at all (quality floor).
MODEL_MIN_AUC=0.80
RF_NUM_TREES=100
RF_MAX_DEPTH=8
FRAUD_DECISION_THRESHOLD=0.5
MODEL_ROOT=s3a://models/fraud_rf
MODEL_METRICS_PATH=s3a://models/fraud_rf/latest.metrics.json
